--// ตัววัด FPS (ใช้ร่วมทุกแท็บ)
local fpsNow = 60
do
local fCount, fAcc = 0, 0
RunService.RenderStepped:Connect(function(dt)
	fCount += 1
	fAcc += dt
	if fAcc >= 0.25 then
		fpsNow = math.floor(fCount / fAcc + 0.5)
		fCount, fAcc = 0, 0
	end
end)
end

local function eachDescendant(fn)
	local list = Workspace:GetDescendants()
	for i, d in ipairs(list) do
		fn(d)
		if i % 400 == 0 then task.wait() end
	end
end

local function isCharPart(d)
	local anc = d.Parent
	while anc and anc ~= Workspace do
		if anc:FindFirstChildOfClass("Humanoid") then return true end
		anc = anc.Parent
	end
	return false
end

local function isBlock(d)
	return d:IsA("BasePart") and not d:IsA("Terrain") and d.Transparency < 1 and not isCharPart(d)
end

local function getRoot()
	local ch = player.Character
	return ch and ch:FindFirstChild("HumanoidRootPart")
end

--// ---------- Lighting เดิม (สำหรับคืนค่า) ----------
local orig = {
	ClockTime = Lighting.ClockTime,
	Brightness = Lighting.Brightness,
	Exposure = Lighting.ExposureCompensation,
	GlobalShadows = Lighting.GlobalShadows,
	Ambient = Lighting.Ambient,
	OutdoorAmbient = Lighting.OutdoorAmbient,
	Diffuse = Lighting.EnvironmentDiffuseScale,
	Specular = Lighting.EnvironmentSpecularScale,
	Soft = Lighting.ShadowSoftness,
}

--// ค่าที่แชร์ระหว่างส่วนต่างๆ (กราฟ FPS, หน้าต่างลอย, ชั้นเอฟเฟกต์ Shader)
local ext = {hud = {}, fx = {}, fxs = {ptype = "None", pcolor = nil, storm = false}, fullbright = false}

--// ---------- SHADER ENGINE ----------
local function getOrCreate(class, name)
	local e = Lighting:FindFirstChild(name)
	if not e or not e:IsA(class) then
		e = Instance.new(class)
		e.Name = name
		e.Parent = Lighting
	end
	return e
end

local fx = {
	cc    = getOrCreate("ColorCorrectionEffect", "NovaCC"),
	bloom = getOrCreate("BloomEffect", "NovaBloom"),
	rays  = getOrCreate("SunRaysEffect", "NovaRays"),
	dof   = getOrCreate("DepthOfFieldEffect", "NovaDoF"),
	blur  = getOrCreate("BlurEffect", "NovaBlur"),
}
for _, e in pairs(fx) do e.Enabled = false end
fx.blur.Size = 0

local atmos = Lighting:FindFirstChildOfClass("Atmosphere")
local atmosMine = false
local atmosOrig
if atmos then
	atmosOrig = {Density = atmos.Density, Offset = atmos.Offset, Color = atmos.Color, Decay = atmos.Decay, Glare = atmos.Glare, Haze = atmos.Haze}
else
	atmos = Instance.new("Atmosphere")
	atmos.Name = "NovaAtmos"
	atmos.Density, atmos.Haze, atmos.Glare = 0, 0, 0
	atmos.Parent = Lighting
	atmosMine = true
end

local DEFAULT = {
	Bright = 0, Contrast = 0, Sat = 0, R = 255, G = 255, B = 255,
	Bloom = 0, BloomSize = 24, Rays = 0, Density = 0, Haze = 0,
	Exposure = 0, DoF = 0, Blur = 0, Time = math.floor(orig.ClockTime * 10 + 0.5) / 10,
	Light = math.floor(orig.Brightness * 10 + 0.5), Soft = math.floor(orig.Soft * 100 + 0.5), Amb = 0,
	Refl = math.floor(orig.Specular * 100 + 0.5), SkyHue = 210, SkySat = 0,
	Vig = 0, Letter = 0, Grain = 0, Scan = 0, WashHue = 210, WashAmt = 0,
	PAmt = 60, PSpd = 100, Cycle = 0, HueCycle = 0, Pulse = 0,
}
local S = {}
for k, v in pairs(DEFAULT) do S[k] = v end

local shaderOn = false
local curPreset = nil

local function applyShader()
	if not shaderOn then
		for _, e in pairs(fx) do e.Enabled = false end
		fx.blur.Size = 0
		Lighting.ClockTime = orig.ClockTime
		Lighting.ExposureCompensation = orig.Exposure
		Lighting.Brightness = orig.Brightness
		Lighting.ShadowSoftness = orig.Soft
		if not ext.fullbright then
			Lighting.Ambient = orig.Ambient
			Lighting.OutdoorAmbient = orig.OutdoorAmbient
		end
		if not (boostState and boostState.shadows) then Lighting.EnvironmentSpecularScale = orig.Specular end
		if atmosMine then
			atmos.Density, atmos.Haze, atmos.Glare = 0, 0, 0
		else
			for k, v in pairs(atmosOrig) do atmos[k] = v end
		end
		ext.fx.apply(false)
		return
	end
	local tint = Color3.fromRGB(S.R, S.G, S.B)
	fx.cc.Brightness = S.Bright / 100
	fx.cc.Contrast = S.Contrast / 100
	fx.cc.Saturation = S.Sat / 100
	fx.cc.TintColor = tint
	fx.cc.Enabled = true

	fx.bloom.Intensity = S.Bloom / 100
	fx.bloom.Size = S.BloomSize
	fx.bloom.Threshold = 0.8
	fx.bloom.Enabled = S.Bloom > 0

	fx.rays.Intensity = S.Rays / 100
	fx.rays.Spread = 0.6
	fx.rays.Enabled = S.Rays > 0

	fx.dof.FarIntensity = S.DoF / 100
	fx.dof.NearIntensity = 0
	fx.dof.FocusDistance = 60
	fx.dof.InFocusRadius = 40
	fx.dof.Enabled = S.DoF > 0

	fx.blur.Size = S.Blur
	fx.blur.Enabled = S.Blur > 0

	--// ท้องฟ้า/หมอก: ถ้าเลือกสีท้องฟ้าจะใช้โทนนั้น ไม่งั้นใช้โทนสีหลักของ Shader
	local white, black = Color3.new(1, 1, 1), Color3.new(0, 0, 0)
	atmos.Density = S.Density / 100
	atmos.Haze = S.Haze / 10
	atmos.Glare = S.Haze / 25
	atmos.Offset = 0.25
	if S.SkySat > 0 then
		atmos.Color = Color3.fromHSV((S.SkyHue % 360) / 360, math.clamp(S.SkySat / 100, 0, 1), 1)
		atmos.Decay = Color3.fromHSV((S.SkyHue % 360) / 360, math.clamp(S.SkySat / 100 + 0.1, 0, 1), 0.55)
	else
		atmos.Color = tint:Lerp(white, 0.5)
		atmos.Decay = tint:Lerp(black, 0.4)
	end

	Lighting.ClockTime = S.Time
	Lighting.ExposureCompensation = S.Exposure / 10
	Lighting.Brightness = S.Light / 10
	Lighting.ShadowSoftness = math.clamp(S.Soft / 100, 0, 1)
	if not ext.fullbright then
		if S.Amb > 0 then
			Lighting.Ambient = tint:Lerp(black, 1 - S.Amb / 100 * 0.55)
			Lighting.OutdoorAmbient = tint:Lerp(black, 1 - S.Amb / 100 * 0.4)
		else
			Lighting.Ambient = orig.Ambient
			Lighting.OutdoorAmbient = orig.OutdoorAmbient
		end
	end
	if not (boostState and boostState.shadows) then
		Lighting.EnvironmentSpecularScale = math.clamp(S.Refl / 100, 0, 1)
	end
	ext.fx.apply(true)
end

