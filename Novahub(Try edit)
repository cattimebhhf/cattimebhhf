	currentStyle = id
	for _, r in ipairs(ROLES) do Theme[r] = s.pal[r] end
	Theme.Hero = s.pal.Hero
	for _, d in ipairs(gui:GetDescendants()) do
		for _, p in ipairs(ROLE_PROPS) do
			local role = d:GetAttribute("t_" .. p)
			if role then d[p] = Theme[role] end
		end
	end
	styleLogo = s.logo
	if s.rainbow then startRainbow() else setAccent(s.accent, s.accent2, true) end
	refreshLogos()
	if setDeco then setDeco(s.deco) end
	for _, fn in ipairs(themeHooks) do pcall(fn) end
end

