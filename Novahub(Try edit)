	tabOrder += 1
	local btn = create("TextButton", {
		BackgroundColor3 = Theme.Surface2, BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 34), Text = "", AutoButtonColor = false,
		LayoutOrder = tabOrder, Parent = tabList,
