local shadowEnabled, shadowStrength, shadowOffsetMul, glowShadow = true, 1, 1, false
local shadowRecords = {}
local depthObjs, textShadowObjs = {}, {}
local depthOn, textShadowOn = true, true

--// เงานุ่ม: ซ้อนเฟรมโปร่งใสหลายชั้น (ไม่ใช้รูปภาพ จึงไม่พึ่ง Asset)
local function addShadow(parent, opt)
	local layers = opt.layers or 8
	local holder = create("Frame", {
		Name = "Shadow", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 0, Visible = shadowEnabled, Parent = parent,
	})
	for i = 1, layers do
		local e = opt.spread * i / layers
		local alpha = (opt.alpha or 0.5) / layers
		local f = create("Frame", {
			Name = "L" .. i, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, opt.offset * shadowOffsetMul),
			Size = UDim2.new(1, e * 2, 1, e * 2), BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1 - math.clamp(alpha * shadowStrength, 0, 0.98),
			BorderSizePixel = 0, Parent = holder,
		}, {create("UICorner", {CornerRadius = opt.round and UDim.new(1, 0) or UDim.new(0, (opt.radius or 14) + e)})})
		table.insert(shadowRecords, {frame = f, alpha = alpha, off = opt.offset, holder = holder})
		if glowShadow then bindAccent(f, "BackgroundColor3") end
	end
	return holder
end
local function refreshShadows()
	for i = #shadowRecords, 1, -1 do
		local r = shadowRecords[i]
		if r.frame.Parent then
			r.frame.BackgroundTransparency = 1 - math.clamp(r.alpha * shadowStrength, 0, 0.98)
			r.frame.Position = UDim2.new(0.5, 0, 0.5, r.off * shadowOffsetMul)
			r.holder.Visible = shadowEnabled
		else
			table.remove(shadowRecords, i)
		end
	end
end
local function setShadowGlow(on)
	glowShadow = on
	for _, r in ipairs(shadowRecords) do
		if r.frame.Parent then
			unbindAccent(r.frame, "BackgroundColor3")
			if on then bindAccent(r.frame, "BackgroundColor3") else r.frame.BackgroundColor3 = Color3.new(0, 0, 0) end
		end
	end
end
local function setDepth(on)
	depthOn = on
	for i = #depthObjs, 1, -1 do
		local d = depthObjs[i]
		if d.hi.Parent then
			d.hi.Visible, d.lo.Visible, d.grad.Enabled = on, on, on
		else
			table.remove(depthObjs, i)
		end
	end
end
local function regTextShadow(label)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = textShadowOn and 0.72 or 1
	table.insert(textShadowObjs, label)
end
local function setTextShadow(on)
	textShadowOn = on
	for i = #textShadowObjs, 1, -1 do
		local l = textShadowObjs[i]
		if l.Parent then l.TextStrokeTransparency = on and 0.72 or 1 else table.remove(textShadowObjs, i) end
	end
end

--// ขอบเรืองแสงของหน้าต่าง (ตั้งค่าจริงหลังสร้างหน้าต่าง)
local mainStrokeRef
local function setGlow(on)
	if not mainStrokeRef then return end
	unbindAccent(mainStrokeRef, "Color")
	if on then
		mainStrokeRef:SetAttribute("t_Color", nil)
		bindAccent(mainStrokeRef, "Color")
		mainStrokeRef.Thickness = 2
		mainStrokeRef.Transparency = 0.25
	else
		mainStrokeRef:SetAttribute("t_Color", "Stroke")
		mainStrokeRef.Color = Theme.Stroke
		mainStrokeRef.Thickness = 1.5
		mainStrokeRef.Transparency = 0
	end
end

