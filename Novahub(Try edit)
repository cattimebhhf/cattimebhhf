--// ===== ระบบสีหลัก (Accent) + เรนโบว์ =====
local accentObjects, onAccentObjects = {}, {}
local accentHooks, themeHooks, animHooks = {}, {}, {}
local rainbow = false
local allConns = {}
local function track(conn)
	table.insert(allConns, conn)
	return conn
end

local function bindAccent(obj, prop)
	table.insert(accentObjects, {obj = obj, prop = prop})
	obj[prop] = Theme.Accent
end
local function unbindAccent(obj, prop)
	for i = #accentObjects, 1, -1 do
		local a = accentObjects[i]
		if a.obj == obj and a.prop == prop then table.remove(accentObjects, i) end
	end
end
local function bindOnAccent(obj, prop)
	table.insert(onAccentObjects, {obj = obj, prop = prop})
	obj[prop] = Theme.OnAccent
end
local function onAccentFor(c)
	local lum = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
	return lum > 0.62 and Color3.fromRGB(16, 16, 22) or Color3.new(1, 1, 1)
end
local function refreshAccentDependents()
	for i = #onAccentObjects, 1, -1 do
		local a = onAccentObjects[i]
		if a.obj.Parent then a.obj[a.prop] = Theme.OnAccent else table.remove(onAccentObjects, i) end
	end
	for _, fn in ipairs(accentHooks) do fn() end
end
local function setAccent(color, color2, instant)
	rainbow = false
	Theme.Accent = color
	Theme.Accent2 = color2 or color
	Theme.OnAccent = onAccentFor(color)
	for i = #accentObjects, 1, -1 do
		local a = accentObjects[i]
		if a.obj.Parent then
			if instant then
				a.obj[a.prop] = color
			else
				TweenService:Create(a.obj, TweenInfo.new(0.3), {[a.prop] = color}):Play()
			end
		else
			table.remove(accentObjects, i)
		end
	end
	refreshAccentDependents()
end
local function rainbowStep()
	local h = (os.clock() * 0.1) % 1
	local c1 = Color3.fromHSV(h, 0.68, 1)
	Theme.Accent = c1
	Theme.Accent2 = Color3.fromHSV((h + 0.25) % 1, 0.68, 1)
	Theme.OnAccent = Color3.fromRGB(16, 16, 22)
	for i = #accentObjects, 1, -1 do
		local a = accentObjects[i]
		if a.obj.Parent then a.obj[a.prop] = c1 else table.remove(accentObjects, i) end
	end
	refreshAccentDependents()
end
local function startRainbow()
	rainbow = true
	rainbowStep()
end
local function seqAccent()
	if rainbow then
		local h = (os.clock() * 0.1) % 1
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHSV(h, 0.68, 1)),
			ColorSequenceKeypoint.new(0.33, Color3.fromHSV((h + 0.2) % 1, 0.68, 1)),
			ColorSequenceKeypoint.new(0.66, Color3.fromHSV((h + 0.4) % 1, 0.68, 1)),
			ColorSequenceKeypoint.new(1, Color3.fromHSV((h + 0.6) % 1, 0.68, 1)),
		})
	end
	return ColorSequence.new(Theme.Accent, Theme.Accent2)
end

local rbAcc = 0
track(RunService.Heartbeat:Connect(function(dt)
	local t = os.clock()
	for _, f in ipairs(animHooks) do f(t) end
	if rainbow then
		rbAcc += dt
		if rbAcc >= 0.04 then
			rbAcc = 0
			rainbowStep()
		end
	end
end))

--// ===== Helpers =====
--// create() จดบทบาทสี (Background/Surface/...) ไว้ในแอตทริบิวต์ เพื่อให้เปลี่ยนสไตล์ได้ทั้งหน้าต่าง
local ROLES = {"Background", "Surface", "Surface2", "Stroke", "Text", "SubText"}
local function tagRole(inst, prop, value)
	if typeof(value) ~= "Color3" then return end
	for _, r in ipairs(ROLES) do
		if value == Theme[r] then
			inst:SetAttribute("t_" .. prop, r)
			return
		end
	end
end
local ROLE_PROPS = {"BackgroundColor3", "TextColor3", "Color", "PlaceholderColor3", "ScrollBarImageColor3"}
local ROLE_PROP_SET = {}
for _, p in ipairs(ROLE_PROPS) do ROLE_PROP_SET[p] = true end

local function create(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		inst[k] = v
		if ROLE_PROP_SET[k] then tagRole(inst, k, v) end
	end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	return inst
end

local function corner(r) return create("UICorner", {CornerRadius = UDim.new(0, r or 8)}) end
local function round() return create("UICorner", {CornerRadius = UDim.new(1, 0)}) end
local function stroke(color, t, trans)
	return create("UIStroke", {Color = color or Theme.Stroke, Thickness = t or 1, Transparency = trans or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
end
local function padding(p)
	return create("UIPadding", {PaddingTop = UDim.new(0, p), PaddingBottom = UDim.new(0, p), PaddingLeft = UDim.new(0, p), PaddingRight = UDim.new(0, p)})
end
local function tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

