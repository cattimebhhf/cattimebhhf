					Rotation = c * 25, BackgroundColor3 = DR.gold, BorderSizePixel = 0, Parent = leg,
				}, {round()})
			end
		end
		if i == SEG then -- หางเป็นเปลว
			for c = -1, 1 do
				create("Frame", {
					AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.6, 0, 0.5, 0), Size = UDim2.new(2.2, 0, 0.45, 0),
					Rotation = 160 + c * 28, BackgroundColor3 = c == 0 and DR.gold or DR.red, BorderSizePixel = 0, Parent = f,
				}, {create("UICorner", {CornerRadius = UDim.new(0.5, 0)})})
			end
		end
		segs[i] = f
	end
	local head = buildDragonHead(dragon, UDim2.fromOffset(96, 96))
	head.ZIndex = SEG + 2
	for _, d in ipairs(head:GetChildren()) do d.ZIndex += SEG end
	-- ไข่มุกมังกร
	local halo = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(44, 44), BackgroundColor3 = DR.gold,
		BackgroundTransparency = 0.8, BorderSizePixel = 0, ZIndex = SEG + 1, Parent = dragon,
	}, {round()})
	local pearl = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = DR.pale, BorderSizePixel = 0, Parent = halo,
	}, {round(), create("UIGradient", {Color = ColorSequence.new(Color3.new(1, 1, 1), DR.gold), Rotation = 45})})

	local px = {}
	table.insert(animHooks, function(t)
		if not dragon.Visible then return end
		local W, H = dragon.AbsoluteSize.X, dragon.AbsoluteSize.Y
		if W < 20 then return end
		for i, f in ipairs(segs) do
			local u = (i - 1) / (SEG - 1)
			local x = (0.70 - 0.62 * u + 0.035 * math.sin(t * 0.7 + u * 3)) * W
			local y = (0.52 + 0.26 * math.sin(t * 0.9 + u * 6.5)) * H
			px[i] = Vector2.new(x, y)
			f.Position = UDim2.fromOffset(x, y)
			local d = 30 * (1 - 0.72 * u) + 5
			f.Size = UDim2.fromOffset(d, d)
			f.BackgroundColor3 = DR.jade:Lerp(DR.jade2, u * 0.7)
		end
		-- หัวหันไปตามทิศที่เลื้อย
		local dir = px[1] - px[3]
		head.Position = UDim2.fromOffset(px[1].X + 14, px[1].Y)
		head.Rotation = math.deg(math.atan2(dir.Y, dir.X))
		halo.Position = UDim2.fromOffset(px[1].X + 78 + math.sin(t * 1.6) * 6, px[1].Y + math.cos(t * 1.3) * 14)
		halo.BackgroundTransparency = 0.72 + 0.12 * math.sin(t * 3)
		for _, c in ipairs(clouds) do
			c.f.Position = UDim2.fromOffset(((c.x0 - t * c.sp) % (W + 140)) - 100, c.y * H)
		end
	end)
	local prev = setDeco
	setDeco = function(on)
		if prev then prev(on) end
		dragon.Visible = on == "dragon"
	end
	--// การ์ดโปร่งขึ้นเล็กน้อยในสไตล์มังกร เพื่อให้เห็นตัวมังกร
	table.insert(themeHooks, function()
		for i = #depthObjs, 1, -1 do
			local c = depthObjs[i].grad.Parent
			if c then c.BackgroundTransparency = currentStyle == "dragon" and 0.3 or 0 end
		end
	end)
end

