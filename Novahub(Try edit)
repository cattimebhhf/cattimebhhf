	return false
end

--// ---------- TEXTURE ENGINE ----------
local texState = {mat = nil, color = nil, useColor = false, near = false, radius = 100, auto = false, tile = 4, id = ""}
local texOrig = setmetatable({}, weak)

local function inRange(d, rootPos)
	if not texState.near then return true end
	if not rootPos then return false end
	return (d.Position - rootPos).Magnitude <= texState.radius
end

local function applyMaterialTo(p)
	if not texOrig[p] then texOrig[p] = {Material = p.Material, Color = p.Color} end
	p.Material = texState.mat
	if texState.useColor and texState.color then p.Color = texState.color end
end

local function applyTextures()
	if not texState.mat then
		notify("Texture", "เลือกวัสดุบล็อคก่อน", "bad", 2.5)
		return
	end
	local root = getRoot()
	local pos = root and root.Position
	local n = 0
	eachDescendant(function(d)
		if isBlock(d) and inRange(d, pos) then
			applyMaterialTo(d)
			n += 1
		end
	end)
	notify("Texture", TF("เปลี่ยน %d บล็อค เป็น %s", n, texState.mat.Name), "good")
end

local function restoreTextures()
	local n = 0
	for p, o in pairs(texOrig) do
		if p.Parent then
			p.Material, p.Color = o.Material, o.Color
			n += 1
		end
	end
	table.clear(texOrig)
	notify("Texture", TF("คืนค่าเดิม %d บล็อค", n), "info")
end

Workspace.DescendantAdded:Connect(function(d)
	if texState.auto and texState.mat and d:IsA("BasePart") and not d:IsA("Terrain") and not isCharPart(d) then
		task.wait()
		if d.Parent and d.Transparency < 1 then applyMaterialTo(d) end
	end
end)

local function applyCustomTexture()
	local id = string.match(texState.id, "%d+")
	if not id then
		notify("Texture", "ใส่ Texture ID (ตัวเลข) ก่อน", "bad", 2.5)
		return
	end
	local root = getRoot()
	local pos = root and root.Position
	local parts, MAX = 0, 500
	eachDescendant(function(d)
		if parts < MAX and isBlock(d) and inRange(d, pos) and not d:FindFirstChild("NovaTex") then
			for _, face in ipairs(Enum.NormalId:GetEnumItems()) do
				local t = Instance.new("Texture")
				t.Name = "NovaTex"
				t.Face = face
				t.Texture = "rbxassetid://" .. id
				t.StudsPerTileU = texState.tile
				t.StudsPerTileV = texState.tile
				t.Parent = d
			end
			parts += 1
		end
	end)
	notify("Texture", (parts >= MAX and TF("ใส่ Texture บน %d บล็อค (สูงสุด %d)", parts, MAX) or TF("ใส่ Texture บน %d บล็อค", parts)), "good")
end

local function removeCustomTexture()
	local n = 0
	eachDescendant(function(d)
		if d.Name == "NovaTex" and d:IsA("Texture") then
			d:Destroy()
			n += 1
		end
	end)
	notify("Texture", TF("ลบ Texture %d ชิ้น", n), "info", 2)
end

