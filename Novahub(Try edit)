--// ลายหยินหยาง (☯) วาดจากวงกลม
local function buildYinYang(parent, size)
	local WH, BK = Color3.fromRGB(246, 246, 244), Color3.fromRGB(20, 20, 20)
	local root = create("Frame", {
		Name = "YinYang", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0), Size = size or UDim2.new(1, 0, 1, 0), Parent = parent,
	})
	create("Frame", {
		Name = "Base", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = root,
	}, {
		round(),
		create("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, WH), ColorSequenceKeypoint.new(0.499, WH),
				ColorSequenceKeypoint.new(0.5, BK), ColorSequenceKeypoint.new(1, BK),
			}), Rotation = 0,
		}),
		create("UIStroke", {Color = Color3.fromRGB(110, 110, 110), Thickness = 1, Transparency = 0.35}),
	})
	local function disc(cx, cy, d, color)
		return create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(cx, 0, cy, 0), Size = UDim2.new(d, 0, d, 0),
			BackgroundColor3 = color, BorderSizePixel = 0, Parent = root,
		}, {round()})
	end
	disc(0.5, 0.25, 0.5, WH)
	disc(0.5, 0.75, 0.5, BK)
	disc(0.5, 0.25, 0.14, BK)
	disc(0.5, 0.75, 0.14, WH)
	return root
end

