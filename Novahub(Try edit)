local function makeLogo(parent, size)
	local root = create("Frame", {
		Name = "Logo", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0), Size = size, Parent = parent,
	})
	local nova = create("Frame", {Name = "Nova", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = root})
	local ring = create("Frame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = nova,
	}, {round()})
	local ringGrad = create("UIGradient", {Color = seqAccent(), Rotation = 0, Parent = ring})
	local disc = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0.84, 0, 0.84, 0),
		BackgroundColor3 = Theme.Surface, BorderSizePixel = 0, Parent = nova,
	}, {round()})
	local star = create("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Text = "✦", TextScaled = true,
		Font = Enum.Font.GothamBlack, TextColor3 = Color3.new(1, 1, 1), Parent = disc,
	}, {create("UIPadding", {PaddingTop = UDim.new(0.12, 0), PaddingBottom = UDim.new(0.12, 0), PaddingLeft = UDim.new(0.12, 0), PaddingRight = UDim.new(0.12, 0)})})
	star:SetAttribute("nofont", true)
	local starGrad = create("UIGradient", {Color = seqAccent(), Rotation = 45, Parent = star})
	local yy = buildYinYang(root)
	local img = create("ImageLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Image = "", ScaleType = Enum.ScaleType.Fit,
		Visible = false, Parent = root,
	}, {round()})
	local dr = buildDragonHead(root, UDim2.new(1, 0, 1, 0))
	dr.Visible = false
	local entry = {root = root, nova = nova, yy = yy, img = img, dr = dr}
	table.insert(logos, entry)
	table.insert(accentHooks, function()
		ringGrad.Color = seqAccent()
		starGrad.Color = seqAccent()
	end)
	table.insert(animHooks, function(t)
		if root.Parent then
			ringGrad.Rotation = (t * 55) % 360
			yy.Rotation = (t * 28) % 360
			dr.Rotation = (t * 80) % 360
		end
	end)
	refreshLogos()
	return root
end

