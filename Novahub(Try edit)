		onLang(function() ttl.Text = string.upper(T(key)) end)
		vals[idx] = create("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.new(0, x, 0, y + 13), Size = UDim2.new(0, cw - 6, 0, 18),
			Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Theme.Text, TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left, Text = "--", Parent = glass,
		})
		vals[idx]:SetAttribute("notr", true)
	end

	local function setPanel(on)
		panelOn = on
		arrow.Text = on and "▾" or "▴"
		glass.Visible = on
		tween(hudRoot, 0.25, {Size = UDim2.new(0, hudW, 0, fullH())}, Enum.EasingStyle.Quint)
	end
	arrow.MouseButton1Click:Connect(function() setPanel(not panelOn) end)
	ext.hud.setPanel = setPanel
	ext.hud.setVisible = function(on) hudRoot.Visible = on end
	ext.hud.setGlass = function(v) glass.BackgroundTransparency = v / 100 end

	--// ลากย้ายได้
	do
		local dragging, startInput, startPos = false, nil, nil
		bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging, startInput, startPos = true, input.Position, hudRoot.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then dragging = false end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local d = input.Position - startInput
				hudRoot.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end)
	end

	task.spawn(function()
		while gui.Parent do
			fpsL.Text = "⚡ " .. fpsNow
			fpsL.TextColor3 = fpsNow >= 50 and Theme.Good or (fpsNow >= 30 and Theme.Warn or Theme.Bad)
			local ping = math.floor(player:GetNetworkPing() * 1000 * 2)
			pingL.Text = "📶 " .. ping .. "ms"
			local act = ext.boostActive()
			if act > 0 then
				pill.BackgroundColor3, pill.TextColor3 = Theme.Accent, Theme.OnAccent
				if ext.post and ext.pre then
					local g = math.floor((ext.post - ext.pre) / math.max(ext.pre, 1) * 100 + 0.5)
					pill.Text = TF("⚡ BOOSTED %s%d%%", g >= 0 and "+" or "", g)
				else
					pill.Text = T("⚡ BOOSTED")
				end
			else
				pill.BackgroundColor3, pill.TextColor3 = Theme.Surface2, Theme.SubText
				pill.Text = T("BOOST OFF")
			end
			if panelOn then
				vals[1].Text = act > 0 and TF("ON · %d/7", act) or T("OFF")
				vals[1].TextColor3 = act > 0 and Theme.Good or Theme.SubText
				vals[2].Text = shaderOn and (curPreset or T("Custom")) or T("OFF")
				vals[2].TextColor3 = shaderOn and Theme.Accent or Theme.SubText
				local texOn = texState.mat ~= nil and next(texOrig) ~= nil
				vals[3].Text = texOn and texState.mat.Name or T("OFF")
				vals[3].TextColor3 = texOn and Theme.Accent or Theme.SubText
				vals[4].Text = ping .. " ms"
				vals[4].TextColor3 = ping < 80 and Theme.Good or (ping < 160 and Theme.Warn or Theme.Bad)
				vals[5].Text = #Players:GetPlayers() .. " / " .. Players.MaxPlayers
				vals[6].Text = tostring(speedVal)
			end
			task.wait(0.25)
		end
	end)
end)()

