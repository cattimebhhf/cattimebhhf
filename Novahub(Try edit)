	local function buildGhost()
		local m = Instance.new("Model")
		m.Name = "GhostAuto"
		for _, d in ipairs(GHOST_PARTS) do
			local p = Instance.new("Part")
			p.Name = d[1]
			p.Size = Vector3.new(d[5], d[6], d[7]) / 100
			p.CFrame = CFrame.new(d[2] / 100, d[3] / 100, d[4] / 100, d[8], d[9], d[10], d[11], d[12], d[13], d[14], d[15], d[16])
			p.Color = Color3.fromRGB(d[17], d[18], d[19])
			p.Material = Enum.Material.SmoothPlastic
			p.Anchored, p.CanCollide = true, false
			create("SpecialMesh", {MeshType = Enum.MeshType.Sphere, Parent = p})
			p.Parent = m
		end
		return m
	end

	--// เตรียมสำเนาโมเดลให้ใช้ใน ViewportFrame ได้
	local function prepare(src)
		local m
		if src:IsA("Model") then
			m = src:Clone()
		elseif src:IsA("BasePart") then
			m = Instance.new("Model")
			local p = src:Clone()
			if p then p.Parent = m end
		else
			m = Instance.new("Model")
			for _, c in ipairs(src:GetChildren()) do
				local cl = c:Clone()
				if cl then cl.Parent = m end
			end
		end
		if not m then return nil end
		local junk, parts = {}, 0
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored, d.CanCollide, d.CanTouch = true, false, false
				parts += 1
			elseif d:IsA("LuaSourceContainer") or d:IsA("Humanoid") then
				table.insert(junk, d)
			end
		end
		for _, j in ipairs(junk) do j:Destroy() end
		if m:IsA("Model") and parts == 0 then return nil end
		return m
	end

	--// ย่อ/ขยายให้พอดีกรอบ ตั้งจุดหมุนที่กลางตัว แล้ววางลงใน Viewport
	local function mount(m, label)
		if not m then return false end
		if M.model then M.model:Destroy() end
		m.PrimaryPart = nil
		m.Parent = vpf
		local _, size = m:GetBoundingBox()
		local maxD = math.max(size.X, size.Y, size.Z)
		if maxD <= 0 then
			m:Destroy()
			return false
		end
		pcall(function() m:ScaleTo(m:GetScale() * 4 / maxD) end)
		local cf2 = m:GetBoundingBox()
		m.WorldPivot = cf2
		m:PivotTo(CFrame.Angles(0, math.pi, 0) * cf2.Rotation)
		M.model, M.base = m, m:GetPivot()
		M.baseScale = m:GetScale()
		M.curScale = M.baseScale * M.size / 100
		pcall(function() m:ScaleTo(M.curScale) end)
		local n = 0
		for _, d in ipairs(m:GetDescendants()) do if d:IsA("BasePart") then n += 1 end end
		M.statusName, M.statusN = label or m.Name, n
		updateStatus()
		return true
	end

