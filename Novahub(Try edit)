	{name = "Arcade",       f = {"Arcade"}},
	{name = "SciFi",        f = {"SciFi"}},
	{name = "Fantasy",      f = {"Fantasy"}},
}
local FAMILIES = {}
for _, def in ipairs(FAMILY_DEFS) do
	local fonts, ok = {}, true
	for i, n in ipairs(def.f) do
		local good, v = pcall(function() return Enum.Font[n] end)
		if good and v then fonts[i] = v else ok = false break end
	end
	if ok then
		local out = {}
		for w = 1, 4 do out[w] = fonts[math.min(w, #fonts)] end
		table.insert(FAMILIES, {name = def.name, fonts = out})
	end
end
local WEIGHT = {
	[Enum.Font.Gotham] = 1, [Enum.Font.GothamMedium] = 2,
	[Enum.Font.GothamBold] = 3, [Enum.Font.GothamBlack] = 4,
}
local curFamily = FAMILIES[1].fonts
local function fontObj(d)
	if (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) and not d:GetAttribute("nofont") then
		local w = d:GetAttribute("fw")
		if not w then
			w = WEIGHT[d.Font] or 1
			d:SetAttribute("fw", w)
		end
		d.Font = curFamily[w]
	end
end
local function applyFont(root)
	for _, d in ipairs(root:GetDescendants()) do fontObj(d) end
end

