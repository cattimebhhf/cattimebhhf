	{name = "Michroma",     f = {"Michroma"}},
	{name = "Merriweather", f = {"Merriweather"}},
	{name = "Josefin Sans", f = {"JosefinSans"}},
	{name = "Titillium",    f = {"TitilliumWeb"}},
	{name = "Fredoka",      f = {"FredokaOne"}},
	{name = "Indie Flower", f = {"IndieFlower"}},
