local notificationsEnabled = true
local function notify(title, text, kind, duration)
	if not notificationsEnabled then return end
	title, text = T(title), T(text)
	duration = duration or 3
	local color = kind == "good" and Theme.Good or kind == "bad" and Theme.Bad or Theme.Accent
	local holder = create("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 64), Parent = notifHolder})
	local slide = create("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(1, 320, 0, 0), Parent = holder,
	})
	addShadow(slide, {spread = 14, offset = 5, layers = 6, radius = 10, alpha = 0.6})
	create("Frame", {
		BackgroundColor3 = Theme.Surface, Size = UDim2.new(1, 0, 1, 0), Parent = slide,
	}, {
		corner(10), stroke(Theme.Stroke),
		create("Frame", {BackgroundColor3 = color, Size = UDim2.new(0, 4, 1, -16), Position = UDim2.new(0, 8, 0, 8), BorderSizePixel = 0}, {corner(2)}),
		create("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.new(0, 22, 0, 8), Size = UDim2.new(1, -32, 0, 20),
			Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Theme.Text, TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left, Text = title,
		}),
		create("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.new(0, 22, 0, 28), Size = UDim2.new(1, -32, 0, 28),
			Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.SubText, TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = text,
		}),
	})
	applyFont(holder)
	tween(slide, 0.35, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back)
	task.delay(duration, function()
		tween(slide, 0.3, {Position = UDim2.new(1, 320, 0, 0)})
		task.wait(0.35)
		holder:Destroy()
	end)
end


