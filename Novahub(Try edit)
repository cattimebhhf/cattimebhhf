local function Toggle(parent, name, desc, default, callback)
	local c = card(parent, 48)
	titleDesc(c, name, desc, 0.75)
	local state = default or false
	local trackBtn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.new(0, 42, 0, 22),
		BackgroundColor3 = Theme.Surface2, Text = "", AutoButtonColor = false, Parent = c,
	}, {round(), stroke(Theme.Stroke)})
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.new(0, 16, 0, 16), BackgroundColor3 = Theme.SubText,
		Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), Parent = trackBtn,
	}, {round()})
	local function paint(animate)
		local tc = state and Theme.Accent or Theme.Surface2
		local kc = state and Theme.OnAccent or Theme.SubText
		trackBtn:SetAttribute("t_BackgroundColor3", nil)
		knob:SetAttribute("t_BackgroundColor3", nil)
		if animate then
			tween(trackBtn, 0.2, {BackgroundColor3 = tc})
			tween(knob, 0.2, {BackgroundColor3 = kc})
		else
			trackBtn.BackgroundColor3, knob.BackgroundColor3 = tc, kc
		end
	end
	paint(false)
	table.insert(accentHooks, function() if state then paint(false) end end)
	table.insert(themeHooks, function() paint(false) end)
	local function set(v, fire)
		if state == v and not fire then return end
		state = v
		paint(true)
		tween(knob, 0.2, {Position = v and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)}, Enum.EasingStyle.Back)
		if callback then task.spawn(callback, v) end
	end
	trackBtn.MouseButton1Click:Connect(function() set(not state, true) end)
	return {Set = function(v) set(v) end, Get = function() return state end}
end

local function Slider(parent, name, min, max, default, callback, suffix)
	local c = card(parent, 58)
	suffix = suffix or ""
	local value = default or min
	titleDesc(c, name, nil, 0.7)
	c:FindFirstChildOfClass("TextLabel").Size = UDim2.new(0.7, -28, 0, 28)
	local function fmt(v) return tostring(math.floor(v * 10 + 0.5) / 10) .. suffix end
	local valLabel = create("TextLabel", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 0),
		Size = UDim2.new(0.3, 0, 0, 28), Font = Enum.Font.GothamBold, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right, Text = fmt(value), Parent = c,
	})
	valLabel:SetAttribute("notr", true)
	bindAccent(valLabel, "TextColor3")
	local track = create("Frame", {
		BackgroundColor3 = Theme.Surface2, Position = UDim2.new(0, 14, 0, 38), Size = UDim2.new(1, -28, 0, 6), Parent = c,
	}, {round()})
	local fill = create("Frame", {Size = UDim2.new((value - min) / (max - min), 0, 1, 0), Parent = track}, {round()})
	bindAccent(fill, "BackgroundColor3")
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 14, 0, 14),
		BackgroundColor3 = Color3.new(1, 1, 1), Parent = fill,
	}, {round()})
	local ks = stroke(Theme.Accent, 2)
	ks.Parent = knob
	bindAccent(ks, "Color")

	local function setValue(v, fire)
		value = math.clamp(v, min, max)
		valLabel.Text = fmt(value)
		tween(fill, 0.06, {Size = UDim2.new((value - min) / (max - min), 0, 1, 0)})
		if fire and callback then callback(value) end
	end
	local dragging = false
	local function update(x)
		local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		setValue(math.floor(min + (max - min) * rel + 0.5), true)
	end
	c.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(i.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			update(i.Position.X)
		end
	end)
	return {Set = function(v) setValue(v, false) end, Get = function() return value end}
end

local function Dropdown(parent, name, options, default, callback)
