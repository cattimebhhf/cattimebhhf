		Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Theme.Text, Text = icon, Parent = btn,
	})
	local label = create("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.new(0, 34, 0, 0), Size = UDim2.new(1, -36, 1, 0),
