		}, {corner(6), create("UIPadding", {PaddingLeft = UDim.new(0, 10)})})
		o:SetAttribute("o", opt)
		o.MouseEnter:Connect(function() tween(o, 0.12, {BackgroundTransparency = 0}) end)
		o.MouseLeave:Connect(function() tween(o, 0.12, {BackgroundTransparency = 1}) end)
		o.MouseButton1Click:Connect(function()
			selected.Text = T(opt)
			selected:SetAttribute("o", opt)
			if open then toggleOpen() end
			if callback then callback(opt) end
		end)
	end
	headBtn.MouseButton1Click:Connect(toggleOpen)
	return {Set = function(opt) selected.Text = T(opt) selected:SetAttribute("o", opt) end}
