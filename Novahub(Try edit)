local pages, tabButtons, currentTab = {}, {}, nil

local function createPage(name)
	local page = create("ScrollingFrame", {
		Name = name, BackgroundTransparency = 1, Visible = false,
		Size = UDim2.new(1, 0, 1, 0), CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Accent, BorderSizePixel = 0, Parent = content,
	}, {
		padding(14),
		create("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder}),
	})
	bindAccent(page, "ScrollBarImageColor3")
	pages[name] = page
	return page
end

local function selectTab(name)
	if currentTab == name then return end
	currentTab = name
	for n, page in pairs(pages) do
		if n == name then
			page.Visible = true
			page.Position = UDim2.new(0, 0, 0, 14)
			tween(page, 0.3, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Quint)
		else
			page.Visible = false
		end
	end
	for n, t in pairs(tabButtons) do
		local active = n == name
		tween(t.button, 0.2, {BackgroundTransparency = active and 0 or 1})
		tween(t.label, 0.2, {TextColor3 = active and Theme.Text or Theme.SubText})
		tween(t.bar, 0.25, {Size = UDim2.new(0, 3, 0, active and 18 or 0)})
	end
end

table.insert(themeHooks, function()
	for n, t in pairs(tabButtons) do
		t.label.TextColor3 = (n == currentTab) and Theme.Text or Theme.SubText
	end
end)

local tabOrder = 0
