	}, {corner(12), stroke(Theme.Stroke, 1, 0.4)})
	local defs = {"FPS BOOST", "SHADER", "Texture", "PING", "ผู้เล่นในเซิร์ฟเวอร์", "WalkSpeed"}
	local vals = {}
	local cw = (hudW - 24) / 3
	for idx, key in ipairs(defs) do
		local col, row = (idx - 1) % 3, (idx - 1) // 3
		local x, y = 12 + col * cw, 8 + row * 38
		local ttl = create("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.new(0, x, 0, y), Size = UDim2.new(0, cw - 6, 0, 12),
			Font = Enum.Font.GothamMedium, TextSize = 9, TextColor3 = Theme.SubText, TextTruncate = Enum.TextTruncate.AtEnd,
