	})
	local list = create("Frame", {
		BackgroundTransparency = 1, Position = UDim2.new(0, 8, 0, HEAD), Size = UDim2.new(1, -16, 0, #options * ROW), Parent = c,
	}, {create("UIListLayout", {Padding = UDim.new(0, 0)})})
	local open = false
	local function toggleOpen()
		open = not open
		tween(c, 0.25, {Size = UDim2.new(1, 0, 0, open and (HEAD + #options * ROW + 8) or HEAD)}, Enum.EasingStyle.Quint)
		tween(arrow, 0.25, {Rotation = open and 180 or 0})
