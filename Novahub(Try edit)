		if grainN > 0 then
			grainAcc += dt
			if grainAcc > 0.07 then
				grainAcc = 0
				for i = 1, grainN do dots[i].Position = UDim2.fromOffset(math.random(0, W), math.random(0, H)) end
			end
		end
		if S.Cycle > 0 then
			S.Time = (S.Time + dt * S.Cycle / 100 * 0.6) % 24
			Lighting.ClockTime = S.Time
		end
		if S.HueCycle > 0 then
			local c = Color3.fromHSV((t * S.HueCycle * 0.004) % 1, 0.5, 1)
			fx.cc.TintColor = c
			atmos.Color = c:Lerp(WHITE, 0.4)
			atmos.Decay = c:Lerp(BLACK, 0.5)
		end
		if S.Pulse > 0 and S.Bloom > 0 then
			fx.bloom.Intensity = S.Bloom / 100 * (1 + 0.4 * math.sin(t * 2.2) * S.Pulse / 100)
		end
		if FS.storm then
			stormTimer -= dt
			if stormTimer <= 0 then
				stormTimer = rnd(3, 9)
				task.spawn(function()
					flash.BackgroundTransparency = 0.35
					tween(flash, 0.3, {BackgroundTransparency = 1})
					task.wait(0.14)
					flash.BackgroundTransparency = 0.5
					tween(flash, 0.4, {BackgroundTransparency = 1})
				end)
			end
		end
	end))
end)()

--// ---------- FPS BOOST ENGINE ----------
local weak = {__mode = "k"}
local bsaved = {
	effects = setmetatable({}, weak), particles = setmetatable({}, weak),
	parts = setmetatable({}, weak), decals = setmetatable({}, weak),
}
local boostState = {shadows = false, effects = false, particles = false, water = false, materials = false, textures = false, quality = false}
local PARTICLES = {ParticleEmitter = true, Trail = true, Beam = true, Fire = true, Smoke = true, Sparkles = true}
local qualityOrig

--// ค่าที่แชร์ระหว่างกราฟ FPS กับหน้าต่างลอย
function ext.boostActive()
	local n = 0
	for _, v in pairs(boostState) do if v then n += 1 end end
	return n
end

local Boost = {}

function Boost.shadows(on)
	boostState.shadows = on
	Lighting.GlobalShadows = on and false or orig.GlobalShadows
	Lighting.EnvironmentSpecularScale = on and 0 or orig.Specular
end

function Boost.effects(on)
	boostState.effects = on
	for _, e in ipairs(Lighting:GetChildren()) do
		if e:IsA("PostEffect") and string.sub(e.Name, 1, 4) ~= "Nova" then
			if on then
				if bsaved.effects[e] == nil then bsaved.effects[e] = e.Enabled end
				e.Enabled = false
			elseif bsaved.effects[e] ~= nil then
				e.Enabled = bsaved.effects[e]
				bsaved.effects[e] = nil
			end
		end
	end
end

function Boost.particles(on)
	boostState.particles = on
	eachDescendant(function(d)
		if PARTICLES[d.ClassName] then
			if on then
				if bsaved.particles[d] == nil then bsaved.particles[d] = d.Enabled end
				d.Enabled = false
			elseif bsaved.particles[d] ~= nil then
				d.Enabled = bsaved.particles[d]
				bsaved.particles[d] = nil
			end
		end
	end)
end

local function boostPart(d, on)
	if on then
		if bsaved.parts[d] == nil then
			bsaved.parts[d] = {Material = d.Material, Reflectance = d.Reflectance, CastShadow = d.CastShadow}
		end
		d.Material = Enum.Material.SmoothPlastic
		d.Reflectance = 0
		d.CastShadow = false
	elseif bsaved.parts[d] then
		local o = bsaved.parts[d]
		d.Material, d.Reflectance, d.CastShadow = o.Material, o.Reflectance, o.CastShadow
		bsaved.parts[d] = nil
	end
end

function Boost.materials(on)
	boostState.materials = on
	eachDescendant(function(d)
		if d:IsA("BasePart") and not d:IsA("Terrain") and not isCharPart(d) then boostPart(d, on) end
	end)
end

local function boostDecal(d, on)
	if on then
		if bsaved.decals[d] == nil then bsaved.decals[d] = d.Transparency end
		d.Transparency = 1
	elseif bsaved.decals[d] ~= nil then
		d.Transparency = bsaved.decals[d]
		bsaved.decals[d] = nil
	end
end

function Boost.textures(on)
	boostState.textures = on
	eachDescendant(function(d)
		if d:IsA("Decal") and d.Name ~= "NovaTex" then boostDecal(d, on) end
	end)
end

local waterOrig
function Boost.water(on)
	boostState.water = on
	local t = Workspace:FindFirstChildOfClass("Terrain")
	if not t then return end
	if on then
		waterOrig = waterOrig or {WaterWaveSize = t.WaterWaveSize, WaterWaveSpeed = t.WaterWaveSpeed, WaterReflectance = t.WaterReflectance}
		t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance = 0, 0, 0
	elseif waterOrig then
		for k, v in pairs(waterOrig) do t[k] = v end
	end
end

function Boost.quality(on)
	boostState.quality = on
	local ok = pcall(function()
		local r = settings().Rendering
		if on then
			qualityOrig = qualityOrig or r.QualityLevel
			r.QualityLevel = Enum.QualityLevel.Level01
		elseif qualityOrig then
			r.QualityLevel = qualityOrig
		end
	end)
	if not ok then notify("Graphics", "เกมนี้ไม่อนุญาตให้สคริปต์เปลี่ยนระดับกราฟิก", "bad", 3) end
end

--// ของที่เกิดใหม่ระหว่างเล่น ให้ใช้ Boost ด้วย
Workspace.DescendantAdded:Connect(function(d)
	if boostState.particles and PARTICLES[d.ClassName] then
		bsaved.particles[d] = d.Enabled
		d.Enabled = false
	elseif boostState.textures and d:IsA("Decal") and d.Name ~= "NovaTex" then
		boostDecal(d, true)
	elseif boostState.materials and d:IsA("BasePart") and not d:IsA("Terrain") and not isCharPart(d) then
		boostPart(d, true)
	end
end)

