local LANG_NAMES = {th = "ไทย", en = "English", zh = "中文"}
local LANG_CODES = {th = "TH", en = "EN", zh = "中"}
local LANG_ORDER = {"th", "en", "zh"}
local lang = "th"
local DICT = {}
local langHooks = {}

local function add(th, en, zh)
	local e = {th = th, en = en, zh = zh}
	DICT[th] = e
	DICT[en] = e
end
local function T(s)
	local e = DICT[s]
	return e and e[lang] or s
end
local function TF(s, ...)
	return string.format(T(s), ...)
end
local function onLang(fn)
	table.insert(langHooks, fn)
	fn()
end

local function translateObj(d)
	if d:GetAttribute("notr") then return end
	if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
		local o = d:GetAttribute("o")
		if o == nil and DICT[d.Text] then
			o = d.Text
			d:SetAttribute("o", o)
		end
		if o ~= nil then
			local t = T(o)
			if d:GetAttribute("u") then t = string.upper(t) end
			d.Text = t
		end
		if d:IsA("TextBox") then
			local po = d:GetAttribute("op")
			if po == nil and DICT[d.PlaceholderText] then
				po = d.PlaceholderText
				d:SetAttribute("op", po)
			end
			if po ~= nil then d.PlaceholderText = T(po) end
		end
	end
end
local function translateTree(root)
	for _, d in ipairs(root:GetDescendants()) do translateObj(d) end
end
local function setLang(code)
	if not LANG_NAMES[code] then return end
	lang = code
	translateTree(gui)
	for _, fn in ipairs(langHooks) do pcall(fn) end
end

