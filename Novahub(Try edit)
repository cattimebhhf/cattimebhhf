local function topButton(text, xOffset, hoverColor, w)
	local b = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, xOffset, 0.5, -1),
		Size = UDim2.new(0, w or 28, 0, 28), BackgroundColor3 = Theme.Surface2,
		Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Theme.Text,
		Text = text, AutoButtonColor = false, Parent = topbar,
	}, {corner(8)})
	local function hc() return type(hoverColor) == "function" and hoverColor() or hoverColor end
	b.MouseEnter:Connect(function() tween(b, 0.15, {BackgroundColor3 = hc()}) end)
	b.MouseLeave:Connect(function() tween(b, 0.15, {BackgroundColor3 = Theme.Surface2}) end)
	return b
end
